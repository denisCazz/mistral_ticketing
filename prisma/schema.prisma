generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OPERATORE
}

enum StatoPreventivo {
  BOZZA
  IN_REVISIONE
  INVIATO
  ACCETTATO
  RIFIUTATO
  SCADUTO
}

enum EntityType {
  DIPENDENTE
  AUTOMEZZO
  AZIENDA
}

enum StatoValidita {
  VALIDO
  SCADUTO
  ARCHIVIATO
  DA_REVISIONARE
}

enum StatoIngestione {
  PENDING
  READY
  FAILED
  DA_REVISIONARE
}

enum FonteScadenza {
  FILENAME
  OCR
  MANUALE
  FOLDER
}

enum ExportFormato {
  PDF
  DOCX
}

enum TipoPresenza {
  SEDE
  TRASFERTA
  MUTUA
  PERMESSO
  FERIE
  FESTIVO
}

enum TipoMovimentoMagazzino {
  ENTRATA
  USCITA
  RETTIFICA
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(OPERATORE)
  active       Boolean  @default(true)
  firma        String?
  qualifica    String?
  telefono     String?
  createdAt    DateTime @default(now())

  preventiviComeOperatore Preventivo[]        @relation("PreventivoOperatore")
  cambiamentiPreventivo   PreventivoStoria[]
  preventivoVersioni      PreventivoVersione[]
  preventivoExports       PreventivoExport[]
  rapportini              Rapportino[]
  dipendente              Dipendente?
  scadenzeResponsabile    Scadenza[]
  aiAudits                AiGenerationAudit[]
  movimentiMagazzino      MovimentoMagazzino[]
}

model Cliente {
  id              String   @id @default(cuid())
  ragioneSociale  String
  nome            String?
  cognome         String?
  indirizzo       String?
  numeroCivico    String?
  cap             String?
  citta           String?
  provincia       String?
  telFisso        String?
  cellulare       String?
  email           String?
  partitaIva      String?
  codiceFiscale   String?
  note1           String?
  note2           String?
  note3           String?
  statoAnagrafica String?
  motivoControllo String?
  sourceId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  preventivi Preventivo[]
  rapportini Rapportino[]

  @@index([ragioneSociale])
  @@index([cellulare])
  @@index([email])
  @@index([cognome])
}

model Preventivo {
  id              String          @id @default(cuid())
  numeroPreventivo String         @unique
  clienteId       String
  operatoreId     String
  stato           StatoPreventivo @default(BOZZA)
  introduzione    String?
  condizioni      String?
  validoFino      DateTime?       @db.Date
  versione        Int             @default(1)
  noteInterne     String?
  totaleImponibile Decimal?       @db.Decimal(12, 2)
  totaleIva        Decimal?       @db.Decimal(12, 2)
  totaleFinale     Decimal?       @db.Decimal(12, 2)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  cliente   Cliente              @relation(fields: [clienteId], references: [id])
  operatore User                 @relation("PreventivoOperatore", fields: [operatoreId], references: [id])
  righe     PreventivoRiga[]
  versioni  PreventivoVersione[]
  storia    PreventivoStoria[]
  exports   PreventivoExport[]
  scadenze  Scadenza[]

  @@index([stato])
  @@index([clienteId])
  @@index([operatoreId])
  @@index([validoFino])
}

model PreventivoRiga {
  id                String   @id @default(cuid())
  preventivoId      String
  ordine            Int      @default(0)
  descrizione       String
  quantita          Decimal  @default(1) @db.Decimal(12, 3)
  prezzoUnitario    Decimal  @default(0) @db.Decimal(12, 2)
  scontoPercentuale Decimal  @default(0) @db.Decimal(5, 2)
  aliquotaIva       Decimal  @default(22) @db.Decimal(5, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  preventivo Preventivo @relation(fields: [preventivoId], references: [id], onDelete: Cascade)

  @@index([preventivoId])
}

model PreventivoVersione {
  id             String   @id @default(cuid())
  preventivoId   String
  numeroVersione Int
  snapshotJson   Json
  createdById    String
  createdAt      DateTime @default(now())
  motivo         String?

  preventivo Preventivo         @relation(fields: [preventivoId], references: [id], onDelete: Cascade)
  createdBy  User                 @relation(fields: [createdById], references: [id])
  exports    PreventivoExport[]

  @@unique([preventivoId, numeroVersione])
  @@index([preventivoId])
}

model PreventivoStoria {
  id          String           @id @default(cuid())
  preventivoId String
  statoDa     StatoPreventivo?
  statoA      StatoPreventivo
  changedById String
  changedAt   DateTime         @default(now())
  note        String?

  preventivo Preventivo @relation(fields: [preventivoId], references: [id], onDelete: Cascade)
  changedBy  User       @relation(fields: [changedById], references: [id])

  @@index([preventivoId])
}

model PreventivoExport {
  id           String        @id @default(cuid())
  preventivoId String
  versioneId   String?
  formato      ExportFormato
  storageKey   String
  mimeType     String
  sizeBytes    Int?
  createdById  String
  createdAt    DateTime      @default(now())

  preventivo Preventivo          @relation(fields: [preventivoId], references: [id], onDelete: Cascade)
  versione   PreventivoVersione? @relation(fields: [versioneId], references: [id], onDelete: SetNull)
  createdBy  User                @relation(fields: [createdById], references: [id])

  @@index([preventivoId])
}

model Dipendente {
  id                 String   @id @default(cuid())
  nome               String
  cognome            String
  codiceFiscale      String?  @unique
  active             Boolean  @default(true)
  archiviato         Boolean  @default(false)
  userId             String?  @unique
  categoriaId        String   @default("manutentore")
  /// Override dei costi della categoria (null = usa il valore standard)
  costoGiornata      Decimal? @db.Decimal(12, 2)
  indennitaTrasferta Decimal? @db.Decimal(12, 2)
  costoMutua         Decimal? @db.Decimal(12, 2)
  costoPermesso      Decimal? @db.Decimal(12, 2)
  costoFerie         Decimal? @db.Decimal(12, 2)
  costoFestivo       Decimal? @db.Decimal(12, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user       User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  categoria  CategoriaDipendente @relation(fields: [categoriaId], references: [id])
  documenti  Documento[]
  scadenze   Scadenza[]
  presenze   PresenzaGiorno[]
  costiAccessori CostoAccessorio[]

  @@index([cognome, nome])
  @@index([categoriaId])
}

model CategoriaDipendente {
  id                    String   @id @default(cuid())
  nome                  String   @unique
  sistema               Boolean  @default(false)
  costoGiornata         Decimal  @default(0) @db.Decimal(12, 2)
  indennitaTrasferta    Decimal  @default(0) @db.Decimal(12, 2)
  costoMutua            Decimal  @default(0) @db.Decimal(12, 2)
  costoPermesso         Decimal  @default(0) @db.Decimal(12, 2)
  costoFerie            Decimal  @default(0) @db.Decimal(12, 2)
  costoFestivo          Decimal  @default(0) @db.Decimal(12, 2)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  dipendenti Dipendente[]

  @@index([nome])
}

model PresenzaGiorno {
  id           String       @id @default(cuid())
  dipendenteId String
  data         DateTime     @db.Date
  tipo         TipoPresenza
  note         String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  dipendente Dipendente @relation(fields: [dipendenteId], references: [id], onDelete: Cascade)

  @@unique([dipendenteId, data])
  @@index([data])
  @@index([dipendenteId])
}

model CostoAccessorio {
  id           String   @id @default(cuid())
  dipendenteId String
  data         DateTime @db.Date
  categoria    String
  importo      Decimal  @db.Decimal(12, 2)
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dipendente Dipendente @relation(fields: [dipendenteId], references: [id], onDelete: Cascade)

  @@index([data])
  @@index([dipendenteId, data])
}

model Automezzo {
  id          String   @id @default(cuid())
  targa       String   @unique
  descrizione String?
  superato    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documenti Documento[]
  scadenze  Scadenza[]
}

model Documento {
  id                   String          @id @default(cuid())
  storageKey           String          @unique
  sha256               String          @unique
  mimeType             String
  sizeBytes            Int
  titoloOriginale      String
  categoria            String
  sottocategoria       String?
  entityType           EntityType
  dipendenteId         String?
  automezzoId          String?
  dataDocumento        DateTime?       @db.Date
  dataScadenza         DateTime?       @db.Date
  scadenzaSource       FonteScadenza?
  scadenzaConfidence   Float?
  scadenzaRaw          String?
  /// True se il documento non richiede una data di scadenza
  nonServeScadenza     Boolean         @default(false)
  statoValidita        StatoValidita   @default(VALIDO)
  statoIngestione      StatoIngestione @default(PENDING)
  aiWhitelist          Boolean         @default(false)
  extractedText        String?
  sourcePath           String?
  canonicalDocumentoId String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  dipendente         Dipendente?       @relation(fields: [dipendenteId], references: [id], onDelete: SetNull)
  automezzo          Automezzo?        @relation(fields: [automezzoId], references: [id], onDelete: SetNull)
  canonical          Documento?        @relation("DocumentoDuplicati", fields: [canonicalDocumentoId], references: [id], onDelete: SetNull)
  duplicati          Documento[]       @relation("DocumentoDuplicati")
  testi              DocumentoTesto[]
  chunks             DocumentoChunk[]
  scadenze           Scadenza[]

  @@index([categoria])
  @@index([entityType])
  @@index([dipendenteId])
  @@index([automezzoId])
  @@index([dataScadenza])
  @@index([nonServeScadenza])
  @@index([aiWhitelist])
  @@index([statoValidita])
}

model DocumentoTesto {
  id           String   @id @default(cuid())
  documentoId  String
  content      String
  pageNumber   Int?
  createdAt    DateTime @default(now())

  documento Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  @@index([documentoId])
}

model DocumentoChunk {
  id          String   @id @default(cuid())
  documentoId String
  content     String
  embedding   Json?
  metadata    Json?
  createdAt   DateTime @default(now())

  documento Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  @@index([documentoId])
}

model Scadenza {
  id             String         @id @default(cuid())
  documentoId    String?
  dipendenteId   String?
  automezzoId    String?
  preventivoId   String?
  titolo         String
  descrizione    String?
  dataScadenza   DateTime       @db.Date
  confermata     Boolean        @default(false)
  fonte          FonteScadenza
  confidence     Float?
  rawValue       String?
  responsabileId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  documento    Documento?    @relation(fields: [documentoId], references: [id], onDelete: SetNull)
  dipendente   Dipendente?   @relation(fields: [dipendenteId], references: [id], onDelete: SetNull)
  automezzo    Automezzo?    @relation(fields: [automezzoId], references: [id], onDelete: SetNull)
  preventivo   Preventivo?   @relation(fields: [preventivoId], references: [id], onDelete: SetNull)
  responsabile User?         @relation(fields: [responsabileId], references: [id], onDelete: SetNull)
  alerts       AlertScadenza[]

  @@index([dataScadenza])
  @@index([confermata])
  @@index([documentoId])
}

model AlertScadenza {
  id           String   @id @default(cuid())
  scadenzaId   String
  giorniPrima  Int
  inviatoAt    DateTime @default(now())
  destinatari  String[]
  success      Boolean  @default(true)
  error        String?

  scadenza Scadenza @relation(fields: [scadenzaId], references: [id], onDelete: Cascade)

  @@unique([scadenzaId, giorniPrima, inviatoAt])
  @@index([scadenzaId])
}

model AiGenerationAudit {
  id                String   @id @default(cuid())
  preventivoId      String?
  userId            String
  prompt            String
  model             String
  sources           Json
  outputJson        Json
  promptTokens      Int?
  completionTokens  Int?
  embeddingTokens   Int?
  totalTokens       Int?
  estimatedCostUsd  Decimal? @db.Decimal(12, 6)
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([preventivoId])
  @@index([userId])
  @@index([createdAt])
}

model XlsxDuplicato {
  id         String   @id @default(cuid())
  gruppoId   String
  recordJson Json
  scelto     Boolean  @default(false)
  risolto    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([gruppoId])
  @@index([risolto])
}

/// Rapportino di intervento (antincendio / elettrico) — modulo disabilitabile via env
model Rapportino {
  id                             String    @id @default(cuid())
  utenteId                       String
  clienteId                      String
  dataRichiesta                  DateTime? @db.Date
  dataIntervento                 DateTime  @db.Date
  oraIntervento                  String?
  tipologiaIntervento            String?
  settore                        String
  tipoImpianto                   String
  marca                          String
  modello                        String
  numeroSerie                    String?
  dataAcquisto                   DateTime? @db.Date
  rivenditore                    String?
  tipoIntervento                 String
  motivoChiamata                 String?
  codiceErrore                   String?
  verifiche                      String?
  installazioneEseguitaDa        String?
  descrizione                    String
  spiegataManutenzione           String?
  accessibilita                  String?
  integritaComponente            String?
  conformitaNormativa            String?
  esitoFunzionamento             String?
  presaVisioneCondizioniGaranzia Boolean?  @default(false)
  ubicazione                     String?
  noteUbicazione                 String?
  prossimoIntervento             DateTime? @db.Date
  materialiUtilizzati            String?
  note                           String?
  firmaClientePrivacy            String?
  firmaOperatore                 String?
  firmaCliente                   String?
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt

  utente   User                 @relation(fields: [utenteId], references: [id], onDelete: Restrict)
  cliente  Cliente              @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  immagini RapportinoImmagine[]

  @@index([clienteId])
  @@index([utenteId])
  @@index([dataIntervento])
  @@index([settore])
  @@index([tipoImpianto])
  @@index([prossimoIntervento])
}

model RapportinoImmagine {
  id           String   @id @default(cuid())
  rapportinoId String
  storageKey   String
  mimeType     String
  sizeBytes    Int?
  caption      String?
  createdAt    DateTime @default(now())

  rapportino Rapportino @relation(fields: [rapportinoId], references: [id], onDelete: Cascade)

  @@index([rapportinoId])
}

model Marca {
  id        String   @id @default(cuid())
  nome      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modelli Modello[]
}

model Modello {
  id        String   @id @default(cuid())
  marcaId   String
  nome      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  marca Marca @relation(fields: [marcaId], references: [id], onDelete: Cascade)

  @@unique([marcaId, nome])
  @@index([marcaId])
}

model AziendaSettings {
  id                    String   @id @default("default")
  nomeAzienda           String   @default("Mistral Impianti")
  logo                  String?
  indirizzo             String?
  partitaIva            String?
  codiceFiscale         String?
  pec                   String?
  codiceDestinatarioSdi String?
  telefono              String?
  email                 String?
  /// Costi standard giornalieri (override per dipendente)
  costoGiornata         Decimal  @default(0) @db.Decimal(12, 2)
  indennitaTrasferta    Decimal  @default(0) @db.Decimal(12, 2)
  costoMutua            Decimal  @default(0) @db.Decimal(12, 2)
  costoPermesso         Decimal  @default(0) @db.Decimal(12, 2)
  costoFerie            Decimal  @default(0) @db.Decimal(12, 2)
  costoFestivo          Decimal  @default(0) @db.Decimal(12, 2)
  /// Destinatari extra per alert scadenze (oltre agli admin se alertIncludiAdmin)
  alertEmails           String[] @default([])
  /// Se true, gli admin attivi ricevono gli alert scadenze
  alertIncludiAdmin     Boolean  @default(true)
  updatedAt             DateTime @updatedAt
}

/// Articolo di magazzino — identificato da codice interno (QR) e/o EAN
model Articolo {
  id           String   @id @default(cuid())
  /// Codice interno / contenuto tipico del QR etichetta
  codice       String   @unique
  /// Codice a barre produttore (EAN-13 / EAN-8 / UPC)
  ean          String?  @unique
  nome         String
  descrizione  String?
  unitaMisura  String   @default("pz")
  quantita     Decimal  @default(0) @db.Decimal(12, 3)
  sogliaMinima Decimal  @default(0) @db.Decimal(12, 3)
  ubicazione   String?
  attivo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  movimenti MovimentoMagazzino[]

  @@index([nome])
  @@index([attivo])
}

model MovimentoMagazzino {
  id         String                 @id @default(cuid())
  articoloId String
  tipo       TipoMovimentoMagazzino
  quantita   Decimal                @db.Decimal(12, 3)
  note       String?
  userId     String
  createdAt  DateTime               @default(now())

  articolo Articolo @relation(fields: [articoloId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@index([articoloId])
  @@index([userId])
  @@index([createdAt])
  @@index([tipo])
}
