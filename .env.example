# Mistral Impianti — environment

# PostgreSQL remoto — sostituisci USER, PASSWORD e DB_NAME
DATABASE_URL="postgresql://USER:PASSWORD@212.227.193.249:60001/DB_NAME?schema=public"

NEXTAUTH_URL="http://localhost:3000"
# Auth.js v5 legge AUTH_SECRET; NEXTAUTH_SECRET resta come alias.
AUTH_SECRET="change-me-use-openssl-rand-base64-32-chars-min"
NEXTAUTH_SECRET="change-me-use-openssl-rand-base64-32-chars-min"

# Email (opzionale — Resend)
# RESEND_API_KEY=
EMAIL_FROM="Mistral Impianti <noreply@mistralimpianti.it>"

# Moduli (fail-closed: default OFF — allineare entrambi)
RAPPORTINI_ENABLED=false
NEXT_PUBLIC_RAPPORTINI_ENABLED=false

# Seed admin (obbligatorio, min 12 caratteri)
# SEED_ADMIN_PASSWORD=
# Cloudflare R2 (S3-compatible)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=mistral-docs
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# OpenAI
# OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
DOCUMENT_EMBEDDING_VERSION=document-v2
DOCUMENT_AI_WORKER_POLL_MS=2000
DOCUMENT_EMBEDDING_RETENTION_DAYS=14
DOCUMENT_EMBEDDING_CLEANUP_ENABLED=false
DOCUMENT_SIMILARITY_MIN=0.72

# Cron scadenze (route POST /api/cron/scadenze)
# CRON_SECRET=

# Import documenti (percorso cartella sorgente)
# DOCUMENTI_SOURCE_PATH=/path/to/documenti Mistral Impianti
